          ]
        }
      ]
    },
    {
      "name": "3. 본인 토큰으로 평점 등록 (201 제출 캡처)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/ratings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 1,\n  \"score\": 5,\n  \"comment\": \"재미있게 봤습니다.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('code COMMON201', () => pm.expect(body.code).to.eql('COMMON201'));",
              "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(true));",
              "pm.test('ratingId 응답', () => pm.expect(body.result.ratingId).to.be.a('number'));",
              "pm.test('요청 body에 memberId 없음', () => pm.expect(JSON.parse(pm.request.body.raw)).not.to.have.property('memberId'));",
              "pm.collectionVariables.set('ratingId', body.result.ratingId);"
            ]
          }
        }
      ]
    },
