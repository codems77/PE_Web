{
  "info": {
    "name": "7주차 BE 필수 미션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "워크북 9단계를 순서대로 실행한 다음 본문 실습 API를 확인합니다. 기존 DB에 같은 계정이 있으면 emailA/emailB와 nicknameA/nicknameB를 사용하지 않은 값으로 바꾸세요. 실제 JWT는 Collection Variables에만 런타임 저장됩니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "emailA",
      "value": "a@umc.com",
      "type": "string"
    },
    {
      "key": "emailB",
      "value": "b@umc.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Movie123!",
      "type": "string"
    },
    {
      "key": "nicknameA",
      "value": "영화광A",
      "type": "string"
    },
    {
      "key": "nicknameB",
      "value": "영화광B",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "tamperedToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberIdA",
      "value": "",
      "type": "string"
    },
    {
      "key": "ratingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 준비: 회원 A, B 가입",
      "item": [
        {
          "name": "1-1. 회원 A 가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/members",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nicknameA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "['tokenA', 'tokenB', 'ratingId', 'memberIdA'].forEach(key => pm.collectionVariables.set(key, ''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('code COMMON201', () => pm.expect(body.code).to.eql('COMMON201'));",
                  "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(true));",
                  "pm.test('회원 ID', () => pm.expect(body.result.memberId).to.be.a('number'));",
                  "pm.collectionVariables.set('memberIdA', body.result.memberId);"
                ]
              }
            }
          ]
        },
        {
          "name": "1-2. 회원 B 가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/members",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailB}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nicknameB}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('code COMMON201', () => pm.expect(body.code).to.eql('COMMON201'));",
                  "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. 로그인: 토큰 A, B 발급",
      "item": [
        {
          "name": "2-1. A 로그인 (제출 캡처)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('code COMMON200', () => pm.expect(body.code).to.eql('COMMON200'));",
                  "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(true));",
                  "pm.test('JWT 발급', () => pm.expect(body.result.accessToken.split('.')).to.have.lengthOf(3));",
                  "pm.test('비밀번호 미노출', () => pm.expect(body.result).not.to.have.property('password'));",
                  "pm.collectionVariables.set('tokenA', body.result.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2-2. B 로그인",
          "request": {
            "method": "POST",
            "header": [
              {
