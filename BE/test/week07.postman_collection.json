                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('code AUTH401_1', () => pm.expect(body.code).to.eql('AUTH401_1'));",
                  "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "변조한 토큰",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/members/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tamperedToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const parts = pm.collectionVariables.get('tokenA').split('.');",
                  "parts[1] = (parts[1][0] === 'a' ? 'b' : 'a') + parts[1].slice(1);",
                  "pm.collectionVariables.set('tamperedToken', parts.join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('code AUTH401_3', () => pm.expect(body.code).to.eql('AUTH401_3'));",
                  "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
